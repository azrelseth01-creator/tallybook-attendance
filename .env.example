# Copy to .env for local work (npm run dev). On Vercel, add the same names under
# Project -> Settings -> Environment Variables. Sign-in passwords are required;
# the other values are optional.
# These only SEED a brand-new class book; anything you change later in
# Settings is saved in the browser and wins over these values.

# --- Branding / defaults ----------------------------------------------------
APP_NAME=Tallybook
SCHOOL_NAME=Maple Grove Elementary
CLASS_NAME=Grade 5 - Sunflower
TEACHER_NAME=Ms. Villeza
ACADEMIC_YEAR=2026-2027
TERM_NAME=Term 4

# --- Attendance rules ---------------------------------------------------------
# A student is flagged once their absences reach this number.
ABSENCE_ALERT_THRESHOLD=5
# This many lates count as one absence (0 = lates never turn into absences).
LATE_TO_ABSENCE=3

# --- Background music ---------------------------------------------------------
# YouTube / Spotify / .mp3 links, separated by commas or new lines.
DEFAULT_MUSIC_URLS=https://www.youtube.com/watch?v=jfKfPfyJRdk

# --- Sign-in (the password screen) --------------------------------------------
# NORMAL_PASSWORD: view only. Opens every tab and every class (even password-protected ones)
#                  but cannot add or change anything.
# ADMIN_PASSWORD:  can add and edit classes, students and attendance. Class passwords still apply.
# Both are checked on the server (/api/auth). Use different, private values.
# NOTE: they keep casual visitors out; they are not encryption of data stored in the browser.
NORMAL_PASSWORD=
ADMIN_PASSWORD=

# --- Optional cloud sync (follow your class book across devices) -------------------
# Create a free Redis database at upstash.com (or add Upstash from the Vercel
# Marketplace), then paste its REST URL and token. Vercel KV names also work:
# KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
